# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for emails/notifications/cron/AI writes. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cloudinary (server-side signed uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email: Gmail SMTP with an App Password (Google Account → Security → App passwords) ----
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Workline

# ---- AI (optional; falls back to a labelled rule-based check when unset) ----
# AI_PROVIDER: anthropic | openai | openai_compatible
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Only for openai_compatible (or to override a provider URL)
AI_BASE_URL=

# ---- Cron (Vercel Cron sends this as a Bearer token; also use it for any other scheduler) ----
CRON_SECRET=
